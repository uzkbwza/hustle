# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

workspace/

# Ignore the Android compiler, for some reason it replicates the entire project inside it - VineRaio
android/build/
# Except for the java file. needed for swipe back to not close the app.
!android/build/src/com/godot/game/GodotApp.java

# Android signing keys (never commit)
*.keystore
*.jks
*.credentials.txt

# mod.io credentials (never commit; copy modio.cfg.example to modio.cfg)
modloader/modio/modio.cfg
